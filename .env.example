# Supabase project settings from Project Settings > API.
# This publishable key is designed for browser use with Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# QR 발급 기준 주소. 운영에서는 실제 HTTPS 주소로 설정합니다.
SITE_URL=http://localhost:3000

# 영업 마감 경고 시각(한국 시간, HH:MM). 운영 시각 확정 전에는 비워 둡니다.
# PENDING_WARNING_TIME_KST=21:00
